<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<!-- Yocto upstream servers -->
	<remote name="yocto" fetch="https://git.yoctoproject.org"/>
	<remote name="oe" fetch="https://git.openembedded.org"/>
	<remote name="github" fetch="https://github.com"/>

	<!-- ========================= -->
	<!-- Yocto Project 6.0 Wrynose -->
	<!-- ========================= -->

	<default remote="yocto"
		revision="wrynose"/>

	<!-- BitBake -->
	<project name="bitbake"
		remote="oe"
		path="bitbake"
		revision="2.18"/>

	<!-- OpenEmbedded-Core -->
	<project name="openembedded-core"
		remote="oe"
		path="openembedded-core"
		revision="wrynose"/>

	<!-- Yocto metadata -->
	<project name="meta-yocto"
		remote="yocto"
		path="meta-yocto"
		revision="wrynose"/>

	<!-- Meta-openembedded -->
	<project name="meta-openembedded"
		remote="oe"
		path="meta-openembedded"
		revision="wrynose"/>

	<!-- Security layer -->
	<project name="meta-security"
		remote="yocto"
		path="meta-security"
		revision="wrynose"/>

	<!-- Virtualization layer -->
	<project name="meta-virtualization"
		remote="yocto"
		path="meta-virtualization"
		revision="wrynose"/>

	<!-- RAUC -->
	<project name="rauc/meta-rauc"
		remote="github"
		path="meta-rauc"
		revision="wrynose"/>

	<!-- ========================= -->
	<!-- AccopsOS RELEASED LAYERS -->
	<!-- ========================= -->

	<project name="Flextride/meta-accopsOS"
		remote="github"
		path="meta-accopsOS"
		revision="develop-wrynose"/>

	<project name="Flextride/meta-accopspkgs"
		remote="github"
		path="meta-accopspkgs"
		revision="develop-wrynose"/>

	<project name="Flextride/meta-accopsapps"
		remote="github"
		path="meta-accopsapps"
		revision="develop-wrynose"/>

</manifest>
