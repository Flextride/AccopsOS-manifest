<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Yocto upstream servers -->
  <remote name="yocto" fetch="https://git.yoctoproject.org"/>
  <remote name="oe" fetch="https://git.openembedded.org"/>
  <remote name="github" fetch="https://github.com"/>

  <!-- Default: Yocto styhead -->
  <default remote="yocto" revision="styhead"/>

  <!-- Poky -->
  <project name="poky"
           remote="yocto"
           path="poky"
           revision="styhead"/>

  <!-- Meta-openembedded -->
  <project name="meta-openembedded"
           remote="oe"
           path="meta-openembedded"
           revision="styhead"/>

  <!-- Security layer -->
  <project name="meta-security"
           remote="yocto"
           path="meta-security"
           revision="styhead"/>

  <!-- Virtualization layer -->
  <project name="meta-virtualization"
           remote="yocto"
           path="meta-virtualization"
           revision="styhead"/>

  <!-- RAUC -->
  <project name="rauc/meta-rauc"
           remote="github"
           path="meta-rauc"
           revision="styhead"/>

  <!-- ========================= -->
  <!-- AccopsOS RELEASED LAYERS -->
  <!-- ========================= -->

  <project name="Flextride/meta-accopsOS"
           remote="github"
           path="meta-accopsOS"
           revision="refs/tags/FLX_ACCOPS_OS_REL_P3"/>

  <project name="Flextride/meta-accopspkgs"
           remote="github"
           path="meta-accopspkgs"
           revision="refs/tags/FLX_ACCOPS_OS_REL_P3"/>

  <project name="Flextride/meta-accopsapps"
           remote="github"
           path="meta-accopsapps"
           revision="refs/tags/FLX_ACCOPS_OS_REL_P3"/>

</manifest>
