<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Define GitHub as the default remote -->
  <remote name="github" fetch="https://github.com"/>

  <!-- Mandatory default element -->
  <default remote="github" revision="styhead"/>

  <!-- Yocto layers -->
  <project name="yoctoproject/poky"
           path="poky"/>

  <project name="yoctoproject/meta-openembedded"
           path="meta-openembedded"/>

  <project name="rauc/meta-rauc"
           path="meta-rauc"/>

  <project name="linuxfoundation/meta-security"
           path="meta-security"/>

  <project name="linuxfoundation/meta-virtualization"
           path="meta-virtualization"/>

  <!-- Your private layers -->
  <project name="pankaj9730/meta-accopsOS"
           path="meta-accopsOS"
           revision="master"/>

  <project name="pankaj9730/meta-accopspkgs"
           path="meta-accopspkgs"
           revision="master"/>

</manifest>

